# Optional server settings and their production-safe defaults.
BIND_ADDRESS=0.0.0.0
PORT=8080
# Valid range: 1..=3600
REQUEST_TIMEOUT_SECONDS=30
# Valid range: 1..=10000
MAX_CONCURRENT_REQUESTS=256
# Valid range: 1..=16777216
MAX_REQUEST_BODY_BYTES=1048576
# Valid range: 1..=300
SHUTDOWN_TIMEOUT_SECONDS=30
RUST_LOG=info
